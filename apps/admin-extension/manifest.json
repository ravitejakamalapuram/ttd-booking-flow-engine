{
  "manifest_version":3,
  "name":"Booking Flow Admin Recorder",
  "version":"0.2.0",
  "description":"Record and author versioned booking workflows from the live page DOM.",
  "permissions":["activeTab","storage","tabs"],
  "host_permissions":["https://ttdevasthanams.ap.gov.in/*"],
  "action":{"default_popup":"popup.html"},
  "background":{"service_worker":"background.js","type":"module"},
  "content_scripts":[{"matches":["https://ttdevasthanams.ap.gov.in/*"],"js":["content.js"],"run_at":"document_idle"}]
}
