{
  "manifest_version":3,
  "name":"Booking Flow Admin Recorder",
  "version":"0.2.0",
  "description":"Record and author versioned booking workflows from the live page DOM.",
  "permissions":["activeTab","storage","tabs"],
  "host_permissions":["https://ttdevasthanams.ap.gov.in/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background":{"service_worker":"background.js","type":"module"},
  "content_scripts":[{"matches":["https://ttdevasthanams.ap.gov.in/*"],"js":["recorder-utils.js","content.js"],"run_at":"document_idle"}]
}
